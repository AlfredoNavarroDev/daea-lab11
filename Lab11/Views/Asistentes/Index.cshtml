@model List<Asistente>

@{
    ViewData["Title"] = "Asistentes";
}

<div class="page-header">
    <h1>Asistentes</h1>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo asistente</a>
</div>

<div class="app-card p-0">
    <div class="table-responsive">
        <table class="table app-table table-hover mb-0">
            <thead>
                <tr>
                    <th>Nombres</th>
                    <th>DNI</th>
                    <th>Correo</th>
                    <th>Teléfono</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var asistente in Model)
                {
                    <tr>
                        <td class="fw-semibold">@asistente.Nombres</td>
                        <td>@asistente.Dni</td>
                        <td>@asistente.Correo</td>
                        <td>@(string.IsNullOrEmpty(asistente.Telefono) ? "—" : asistente.Telefono)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
