@model List<Inscripcion>

@{
    ViewData["Title"] = "Inscripciones";
}

<div class="page-header">
    <h1>Inscripciones</h1>
    <a asp-action="Create" class="btn btn-primary">+ Nueva inscripción</a>
</div>

<div class="app-card p-0">
    <div class="table-responsive">
        <table class="table app-table table-hover mb-0">
            <thead>
                <tr>
                    <th>Evento</th>
                    <th>Asistente</th>
                    <th>Fecha de inscripción</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var inscripcion in Model)
                {
                    <tr>
                        <td class="fw-semibold">@inscripcion.Evento?.Titulo</td>
                        <td>@inscripcion.Asistente?.Nombres</td>
                        <td>@inscripcion.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <span class="badge rounded-pill @(inscripcion.Estado == "Confirmada" ? "badge-estado-confirmada" : "badge-estado-cancelada")">
                                @inscripcion.Estado
                            </span>
                        </td>
                        <td class="text-end">
                            @if (inscripcion.Estado == "Confirmada")
                            {
                                <form asp-action="Cancelar" asp-route-id="@inscripcion.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Cancelar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
